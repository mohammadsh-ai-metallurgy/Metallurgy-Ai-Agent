# پروژه ۳ (نسخه اختصاصی): سیستم کارشناس با پایگاه داده داخلی (دیکشنری)

# ۱. ساخت پایگاه داده عناصر با استفاده از دیکشنری‌های توو در توو (Nested Dictionaries)
elements_db = {
    "Cu": {"name": "Copper", "radius": 0.128, "crystal": "FCC", "en": 1.90},
    "Ni": {"name": "Nickel", "radius": 0.125, "crystal": "FCC", "en": 1.80},
    "Fe": {"name": "Iron", "radius": 0.124, "crystal": "BCC", "en": 1.83},
    "Al": {"name": "Aluminum", "radius": 0.143, "crystal": "FCC", "en": 1.61}
}

def analyze_alloy():
    print("=== سیستم هوشمند ارزیابی حلالیت جامد (پایگاه داده اختصاصی) ===")
    print(f"عناصر موجود در حافظه سیستم: {list(elements_db.keys())}")

    # ۲. گرفتن نام عناصر از کاربر
    el1_input = input("\nنماد عنصر اول (میزبان) را وارد کنید (مثلا Cu): ").strip().capitalize()
    el2_input = input("نماد عنصر دوم (میهمان) را وارد کنید (مثلا Ni): ").strip().capitalize()

    # ۳. بررسی اینکه آیا عناصر در دیتابیس ما وجود دارند یا خیر
    if el1_input not in elements_db or el2_input not in elements_db:
        print("❌ خطا: یکی یا هر دو عنصر در پایگاه داده فعلی (۴ عنصر) وجود ندارند!")
        return

    # ۴. استخراج اطلاعات از دیکشنری
    data1 = elements_db[el1_input]
    data2 = elements_db[el2_input]

    print(f"\n📊 اطلاعات استخراج شده از حافظه:")
    print(f"[{el1_input}]: شعاع={data1['radius']}nm، شبکه={data1['crystal']}، الکترونگاتیوی={data1['en']}")
    print(f"[{el2_input}]: شعاع={data2['radius']}nm، شبکه={data2['crystal']}، الکترونگاتیوی={data2['en']}")

    # ۵. پیاده‌سازی محاسبات متالورژیکی (قوانین هوم-روری)
    score = 0

    # شرط اول: تفاوت شعاع اتمی (فرمول درصد تفاوت)
    r_diff = abs(data1['radius'] - data2['radius']) / data1['radius'] * 100
    if r_diff <= 15:
        radius_result = f"✅ پاس شد (تفاوت شعاع: {r_diff:.1f}٪)"
        score += 1
    else:
        radius_result = f"❌ رد شد (تفاوت شعاع زیاد است: {r_diff:.1f}٪)"

    # شرط دوم: همانند بودن ساختار کریستالی
    if data1['crystal'] == data2['crystal']:
        crystal_result = f"✅ پاس شد (هر دو {data1['crystal']} هستند)"
        score += 1
    else:
        crystal_result = f"❌ رد شد (ساختارها متفاوتند: {data1['crystal']} و {data2['crystal']})"

    # شرط سوم: تفاوت الکترونگاتیوی
    en_diff = abs(data1['en'] - data2['en'])
    if en_diff <= 0.4:
        en_result = f"✅ پاس شد (تفاوت الکترونگاتیوی کم است: {en_diff:.2f})"
        score += 1
    else:
        en_result = f"❌ هشدار (تفاوت زیاد است: {en_diff:.2f}، احتمال تشکیل فاز بین‌فلزی)"

    # ۶. نمایش گزارش نهایی
    print("\n📋 گزارش تحلیل متالورژیکی:")
    print(f"۱. تفاوت شعاع اتمی: {radius_result}")
    print(f"۲. شبکه کریستالی: {crystal_result}")
    print(f"۳. الکترونگاتیوی: {en_result}")

    print("\n📢 نظر نهایی سیستم:")
    if score == 3:
        print(f"🎯 عناصر {el1_input} و {el2_input} انحلال کامل (نامحدود) در یکدیگر دارند.")
    elif score == 2:
        print(f"⚠️ عناصر {el1_input} و {el2_input} انحلال محدود دارند.")
    else:
        print(f"🚫 عناصر {el1_input} و {el2_input} در یکدیگر حل نمی‌شوند.")

# اجرای برنامه
analyze_alloy()# Write your code here :-)
